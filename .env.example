# Copie para .env e substitua somente os valores locais. Não versionar .env.

# CORE / DATABASE / AUTH
PRM_DATABASE_URL=postgresql+psycopg://prm_app:SUBSTITUA_A_SENHA@127.0.0.1:5432/prm_mvp
PRM_ENVIRONMENT=development
PRM_SESSION_COOKIE_SECURE=false
PRM_SESSION_TTL_HOURS=12
PRM_ORGANIZATION_NAME=Organização PRM
PRM_ORGANIZATION_TIMEZONE=America/Sao_Paulo
PRM_MAX_UPLOAD_MIB=20
PRM_MAX_IMPORT_ROWS=50000

# CATÁLOGOS
# Limite independente para CSV/Excel de Catálogos (não Digitalização).
PRM_CATALOG_UPLOAD_MIB=50

# REUNIÕES / PLANNER / ASR
# Reuniões: API somente para interpretação; áudio nunca é enviado ao provedor.
PRM_MEETING_STORAGE_DIR=data/meetings
PRM_MEETING_TEXT_MAX_BYTES=2097152
PRM_MEETING_AI_PROVIDER=anthropic
# Defina um ID de modelo disponível na conta; não herda automaticamente DATASHEET_MODEL.
PRM_MEETING_AI_MODEL=
PRM_MEETING_AI_TIMEOUT_SECONDS=120
PRM_MEETING_AI_MAX_RETRIES=1
PRM_MEETING_AI_MAX_OUTPUT_TOKENS=16000
PRM_MEETING_AI_MAX_INPUT_TOKENS=100000
PRM_MEETING_ENABLE_FIXTURE=false
PRM_MEETING_RETENTION_DAYS=365
PRM_AUDIO_MAX_BYTES=262144000
PRM_AUDIO_MAX_DURATION_SECONDS=14400
# Ambiente separado para bibliotecas nativas ASR, se necessário.
PRM_ASR_PYTHON=
PRM_ASR_MODEL=small
PRM_ASR_MODEL_CACHE_DIR=data/meetings/models
PRM_ASR_LANGUAGE=pt
PRM_ASR_TIMEOUT_SECONDS=14400
PRM_ASR_MEMORY_MIB=4096
# Pasta-base absoluta para digitalizações finalizadas. Padrão: data/products no projeto.
# PRM_PRODUCT_STORAGE_ROOT=D:\PRM\Produtos

# DATASHEETS / ANTHROPIC
ANTHROPIC_API_KEY=SUA_KEY_AQUI
DATASHEET_MODEL=claude-opus-5-5

# DIGITALIZAÇÃO / GERAÇÃO EM LOTE
# Geração em lote: arquivos/fila locais; web e worker devem compartilhar a pasta.
PRM_BATCH_STORAGE_DIR=data/datasheet_batches
PRM_BATCH_UPLOAD_MIB=100
PRM_BATCH_EXPANDED_MIB=500
PRM_BATCH_MAX_FILES=1000
PRM_BATCH_MAX_PRODUCTS=500
PRM_BATCH_MAX_RATIO=200
PRM_BATCH_CONCURRENCY=1
PRM_BATCH_TIMEOUT_SECONDS=900
PRM_BATCH_MAX_ATTEMPTS=3
PRM_BATCH_RETENTION_DAYS=90

# WOOCOMMERCE / WORDPRESS
# Credenciais separadas por loja. Não usar credenciais Frenet.
CHOICE_WC_URL=https://choicetech.com.br
CHOICE_WC_KEY=
CHOICE_WC_SECRET=
CHOICE_WP_USER=
CHOICE_WP_APP_PASSWORD=
SAG_WC_URL=https://sagloja.devsplcomunic.com.br
SAG_WC_KEY=
SAG_WC_SECRET=
SAG_WP_USER=
SAG_WP_APP_PASSWORD=
PORTWELL_WC_URL=https://portwell.com.br
PORTWELL_WC_KEY=
PORTWELL_WC_SECRET=
PORTWELL_WP_USER=
PORTWELL_WP_APP_PASSWORD=
# UUID da organização PRM cujos gestores podem testar estas lojas.
PRM_STORE_ORGANIZATION_ID=
PRM_STORE_TIMEOUT_SECONDS=20
PRM_STORE_STATUS_DIR=data/integrations

# CADASTRO VIA API
# Cadastro API: bloqueado por padrão. Homologação em OUTRA origem e um SKU.
# URLs das três lojas atuais são bloqueadas mesmo se enabled=true.
PRM_PUBLISH_ENABLED=false
PRM_PUBLISH_STAGING_ORIGIN=
PRM_PUBLISH_STAGING_SKU=
PRM_PUBLISH_STORAGE_DIR=data/store_publish
# Cadastro usa PRM_UPLOAD_MAX_FILE_MIB, inclusive no worker.
PRM_PUBLISH_UPLOAD_TIMEOUT_SECONDS=1800

# REMOÇÃO VIA API
# Legado: preservada para ferramentas antigas, NÃO bloqueia o fluxo de remoção role-v1.
# Remoção usa cargo gestor/desenvolvedor, organização, Dry Run aprovado, confirmação e backup.
PRM_REMOVAL_PRODUCTION_ALLOWED=false
# Backup verificado antes de cada remoção (limites e hosts de mídia adicionais, ex.: CDN).
PRM_REMOVAL_BACKUP_MAX_FILE_MIB=200
PRM_REMOVAL_BACKUP_MAX_ITEM_MIB=1024
PRM_REMOVAL_BACKUP_MAX_TOTAL_GIB=50
PRM_REMOVAL_BACKUP_MIN_FREE_GIB=2
PRM_REMOVAL_BACKUP_MEDIA_HOSTS=
 

# RESOLUÇÃO DE IMAGENS
# Modo "pasta no servidor" (opcional): raízes permitidas (separadas por ;).
# Vazio = modo desligado; os usuários enviam a pasta do próprio computador pelo navegador.
PRM_IMAGE_TOOL_ROOTS=

# UPLOADS LOCAIS
# Envios de arquivos/pastas pelo navegador (docs/SELECAO_PASTAS_LOCAIS.md).
PRM_UPLOAD_STORAGE_DIR=data/uploads
PRM_UPLOAD_MAX_MIB=2048
PRM_UPLOAD_MAX_FILE_MIB=1024
PRM_UPLOAD_MAX_FILES=5000
PRM_UPLOAD_CHUNK_MIB=8
PRM_UPLOAD_RETENTION_HOURS=24
PRM_UPLOAD_MAX_OPEN=10

# GITHUB / PAUTA SEMANAL
# Token GitHub fine-grained, somente leitura, só no backend.
PRM_GITHUB_TOKEN=
PRM_GITHUB_REPOSITORY=Arthur-A-C/PRM
# Commit em produção, atualizado a cada implantação. Vazio = nada é considerado implantado.
PRM_DEPLOYED_COMMIT=

# FORNECEDORES / IA
PRM_SUPPLIER_STORAGE_DIR=data/suppliers
# IA para enriquecimento de fornecedores (docs/FORNECEDORES_IA.md). Independente da IA de reuniões/datasheets.
# Chave própria recomendada. Sem chave/modelo o botão "Preencher com IA" informa que não está configurado.
PRM_SUPPLIER_AI_API_KEY=
# Modelo Haiku atual (ID confirmado na documentação da API): claude-haiku-5-5. Só este valor define o modelo.
PRM_SUPPLIER_AI_MODEL=claude-haiku-5-5
PRM_SUPPLIER_AI_TIMEOUT_SECONDS=60
PRM_SUPPLIER_AI_MAX_RETRIES=2
# true = sem PRM_SUPPLIER_AI_API_KEY, reutiliza ANTHROPIC_API_KEY (mesma conta/faturamento). Padrão: false.
PRM_SUPPLIER_AI_ALLOW_SHARED_KEY=false
# low|medium|high; vazio = não envia (use vazio para modelos sem suporte a effort).
PRM_SUPPLIER_AI_EFFORT=low
PRM_SUPPLIER_AI_MAX_OUTPUT_TOKENS=8000
# Limites de custo/abuso.
PRM_SUPPLIER_AI_MAX_INPUT_CHARS=60000
PRM_SUPPLIER_AI_MAX_PAGES=12
PRM_SUPPLIER_AI_PAGE_MAX_BYTES=1500000
PRM_SUPPLIER_AI_PAGE_TEXT_CHARS=12000
PRM_SUPPLIER_AI_FETCH_TIMEOUT_SECONDS=10
PRM_SUPPLIER_AI_CRAWL_SECONDS=45
PRM_SUPPLIER_AI_MAX_DOCUMENT_PAGES=30
PRM_SUPPLIER_AI_MAX_IMAGES=4
PRM_SUPPLIER_AI_CACHE_MINUTES=60
PRM_SUPPLIER_AI_MAX_RUNS_PER_HOUR=30
