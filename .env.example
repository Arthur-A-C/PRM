# Copie para .env e substitua somente os valores locais. Não versionar .env.
PRM_DATABASE_URL=postgresql+psycopg://prm_app:SUBSTITUA_A_SENHA@127.0.0.1:5432/prm_mvp
PRM_ENVIRONMENT=development
PRM_SESSION_COOKIE_SECURE=false
PRM_SESSION_TTL_HOURS=12
PRM_ORGANIZATION_NAME=Organização PRM
PRM_ORGANIZATION_TIMEZONE=America/Sao_Paulo
PRM_MAX_UPLOAD_MIB=20
PRM_MAX_IMPORT_ROWS=50000
# Pasta-base absoluta para digitalizações finalizadas. Padrão: data/products no projeto.
# PRM_PRODUCT_STORAGE_ROOT=D:\PRM\Produtos
ANTHROPIC_API_KEY=SUA_KEY_AQUI
DATASHEET_MODEL=claude-opus-5-5
 

