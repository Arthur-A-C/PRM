# Build context = application code only. Secrets, local data and environments never enter the image.
.git
.gitattributes
.github
.claude
.env
.env.*
*.env
.venv
.venv-*
__pycache__
**/__pycache__
**/*.pyc
.codex
.agents
*.py[cod]
.pytest_cache
pytest-cache-files-*
htmlcov
.coverage
*.log

# Runtime data lives in volumes / bind mounts (7+ GB, SQLite queues, backups, tools).
data
trabalho
backups-docker
chrome-profile*
playwright

