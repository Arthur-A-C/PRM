credenciais*.json
credentials*.json
secrets*.json
*.dump
*.sql
*.sqlite3
*.sqlite3-*
*.db
*.bak
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Tooling not needed inside the image
docs
*.md
!README.md
scripts/*.cjs
compose*.yaml
docker-compose*.yml
Dockerfile
.dockerignore
